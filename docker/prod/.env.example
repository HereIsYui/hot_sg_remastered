# docker/prod 栈配置 — 复制为 docker/prod/.env 后按需修改：
#
#   cp docker/prod/.env.example docker/prod/.env
#   pnpm prod:up
#
# compose 以 docker/prod/ 为项目目录，自动读取同目录下的 .env。
# 修改 GM/客户端相关变量后需要重建 web 镜像：pnpm prod:up（或 docker compose build web）。

# --- Docker Hub 镜像加速（沿用 docker/legacy 的约定）；直连时留空。
#HOT_DOCKER_MIRROR=docker.m.daocloud.io/library/
HOT_DOCKER_MIRROR=

# --- 端口。web 是玩家入口；server/db 只绑定 127.0.0.1 供宿主机调试/运维。
HOT_WEB_PORT=8080
HOT_SERVER_PORT=3000
# 3319，避开开发库（3318）与原版对照库（3317）。
HOT_DB_PORT=3319

# --- MySQL。密码请用字母数字（会拼进 DATABASE_URL 与健康检查命令）。
# 对外网开放时务必改掉默认密码。
MYSQL_ROOT_PASSWORD=hot
MYSQL_DATABASE=bloodwar
MYSQL_USER=hot
MYSQL_PASSWORD=hot

# --- 游戏服务端（apps/server/src/config/app-config.ts）。
# 结算循环开关：只在维护窗口临时关停时设 false。
TICK_ENABLED=true
TICK_INTERVAL_MS=3000
DATABASE_POOL_SIZE=10
LOG_JSON=false
# 8 小时野地刷新任务，与 TICK_ENABLED 共用开关。
WORLD_REFRESH_ENABLED=true
# 交给客户端 loadGlobalData 的服务器标识（对应原版 config/db.php）。
#SERVER_MARK=hot
#SERVER_NAME=hot

# --- GM 后台（/gm/）。
# 服务端 x-gm-token 校验用（apps/server/src/gm/gm-token.guard.ts）；留空 = GM API 全部 403。
GM_TOKEN=
# 编译进 gm 前端包，任何能打开后台的人可见该值，仅适合个人/内网部署；与服务端 GM_TOKEN 一致。
VITE_GM_TOKEN=
# 宝物/装备图片预览目录；nginx 把客户端素材托管在同源 /assets/。
VITE_ASSET_URL=/assets/

# --- 登录页按钮（留空隐藏对应按钮）。
VITE_REGISTER_URL=
VITE_HOME_LABEL=
VITE_HOME_URL=
