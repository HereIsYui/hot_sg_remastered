{
  "name": "hot-sg-remastered",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "build:shared": "pnpm --filter @hot/shared build",
    "dev:server": "pnpm build:shared && pnpm --filter @hot/server dev",
    "dev:client": "pnpm build:shared && pnpm --filter @hot/client dev",
    "dev:gm": "pnpm build:shared && pnpm --filter @hot/gm dev",
    "test": "pnpm build:shared && pnpm -r test",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "legacy:extract": "pnpm --filter @hot/tools extract",
    "legacy:decompile": "pnpm --filter @hot/tools decompile",
    "legacy:assets": "pnpm --filter @hot/tools assets",
    "legacy:dump-db": "pnpm --filter @hot/tools dump-db",
    "legacy:inventory": "pnpm --filter @hot/tools inventory",
    "legacy:up": "docker compose -f docker/legacy/docker-compose.yml --profile tick up -d --build --wait",
    "legacy:down": "docker compose -f docker/legacy/docker-compose.yml --profile tick down",
    "legacy:reset": "docker compose -f docker/legacy/docker-compose.yml --profile tick down -v",
    "legacy:smoke": "pnpm --filter @hot/tools smoke"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
